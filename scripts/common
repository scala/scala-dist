# Params:
#   - state: pending / success / failure / error
function postCommitStatus() {
  [[ -n "$scala_sha" ]] || return 0
  [[ "$scala_sha" =~ ^[0-9a-f]{40}$ ]] || {
    echo "Not a full-length commit SHA: '$scala_sha'"
    exit 1
  }
  [[ -n "$SCALA_REPO_TOKEN" ]] || {
    echo "Missing environment variable SCALA_REPO_TOKEN!"
    exit 1
  }

  local jsonTemplate='{ "state": "%s", "target_url": "%s", "description": "%s", "context": "%s"}'
  local json=$(printf "$jsonTemplate" "$1" "$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" "$1" "gha/scala-dist/$version/$mode/$RUNNER_OS")

  local tmpfile=$(mktemp -t curl.XXXXXXXXXX) || exit 1

  local curlStatus=$(curl \
    -s -o $tmpfile -w "%{http_code}" \
    -H "Accept: application/vnd.github.v3+json" \
    -H "Authorization: token $SCALA_REPO_TOKEN" \
    -d "$json" \
    https://api.github.com/repos/scala/scala/statuses/$scala_sha)

  [[ "$curlStatus" == "201" ]] || {
    echo "Failed to publish GitHub commit status. Got: $curlStatus"
    cat $tmpfile
    exit 1
  }
}
